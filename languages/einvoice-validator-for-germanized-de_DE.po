msgstr "Germanized Pro schreibt Rechnungen automatisch fest"

#: includes/class-eivg-selftest.php:54
msgid "Germanized Pro is active"
msgstr "Germanized Pro ist aktiv"

#: includes/class-eivg-admin.php:70
